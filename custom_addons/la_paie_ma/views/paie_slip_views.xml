<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payslip Tree View -->
    <record id="paie_slip_view_tree" model="ir.ui.view">
        <field name="name">paie.slip.tree</field>
        <field name="model">paie.slip</field>
        <field name="arch" type="xml">
            <list string="Payslips" default_order="date_from desc, id desc">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="wage" widget="monetary"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Payslip Form View -->
    <record id="paie_slip_view_form" model="ir.ui.view">
        <field name="name">paie.slip.form</field>
        <field name="model">paie.slip</field>
        <field name="arch" type="xml">
            <form string="Payslip">
                <header>
                    <button name="action_compute_sheet"
                            string="Compute"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_set_to_draft"
                            string="Set to Draft"
                            type="object"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Payslip Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                            <field name="contract_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="wage" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Computation Details" name="computation_details">
                            <field name="line_ids" readonly="state == 'done'">
                                <list string="Payslip Lines" editable="bottom" create="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Payslip Search View -->
    <record id="paie_slip_view_search" model="ir.ui.view">
        <field name="name">paie.slip.search</field>
        <field name="model">paie.slip</field>
        <field name="arch" type="xml">
            <search string="Search Payslips">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_by_employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Date From" name="group_by_date_from" domain="[]" context="{'group_by': 'date_from'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Payslip Action -->
    <record id="action_paie_slip" model="ir.actions.act_window">
        <field name="name">Payslips</field>
        <field name="res_model">paie.slip</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="paie_slip_view_search"/>
        <field name="context">{'search_default_filter_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new payslip
            </p>
            <p>
                Generate payslips for your employees based on configured salary rules.
            </p>
        </field>
    </record>
</odoo>
